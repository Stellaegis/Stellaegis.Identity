<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Identity</RootNamespace>
    <PackageId>Stellaegis.Identity</PackageId>
    <Description>Stellaegis Identity: the accounts of an application assembled on Stellaegis.Primitives — registration, login, multi-factor authentication, recovery codes, e-mail verification, password reset, the trace of logins — and, for any resource server, whether an account is blocked. It issues no token.</Description>
    <PackageTags>stellaegis;identity;accounts;authentication;password;mfa;totp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellaegis.Primitives" />
    <PackageReference Include="Stellaegis.Primitives.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Otp.NET" />
    <InternalsVisibleTo Include="Stellaegis.Identity.Tests" />
  </ItemGroup>

</Project>
