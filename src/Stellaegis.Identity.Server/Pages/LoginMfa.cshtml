@page "/login/mfa"
@model LoginMfaModel
@{
    ViewData["Title"] = T["Mfa.Title"];
    Layout = "_AuthLayout";
}

<h2 class="auth-h2">@T["Mfa.Heading"]</h2>
<p class="auth-help">@(Model.ByEmail ? T["Mfa.HelpEmail"] : T["Mfa.HelpApp"])</p>

<form class="auth-form" method="post" autocomplete="off">
    <div class="auth-field">
        <label class="auth-label" for="Code">@T["Field.Code"]</label>
        <input class="auth-input auth-input-code" asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus />
    </div>
    <button class="auth-btn" type="submit">@T["Mfa.Submit"]</button>
    <partial name="_Errors" />
</form>

<p class="auth-help auth-small">@T["Mfa.RecoveryHint"]</p>

<div class="auth-links">
    <a href="/login" class="auth-link">@T["Nav.BackToLogin"]</a>
</div>
