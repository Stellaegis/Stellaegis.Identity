@page "/activate"
@model ActivateModel
@{
    ViewData["Title"] = T["Activate.Title"];
    Layout = "_AuthLayout";
}

@if (Model.Done)
{
    <h2 class="auth-h2">@T["Activate.DoneHeading"]</h2>
    <p class="auth-help">@T["Activate.DoneHelp"]</p>
    <div class="auth-links">
        <a href="/login" class="auth-btn">@T["Nav.SignIn"]</a>
    </div>
}
else if (Model.TokenInvalid)
{
    <h2 class="auth-h2">@T["Activate.InvalidHeading"]</h2>
    <p class="auth-help">@T["Activate.InvalidHelp"]</p>
}
else
{
    <h2 class="auth-h2">@T["Activate.Heading"]</h2>
    <p class="auth-help">@T["Activate.Help"]</p>
    <form class="auth-form" method="post" autocomplete="off">
        <input type="hidden" asp-for="Token" />
        <div class="auth-field">
            <label class="auth-label" for="Input_NewPassword">@T["Field.NewPassword"]</label>
            <input class="auth-input" asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus />
            <ul class="auth-rules">
                @foreach (var rule in Model.Rules)
                {
                    <li>@rule</li>
                }
            </ul>
        </div>
        <div class="auth-field">
            <label class="auth-label" for="Input_ConfirmPassword">@T["Field.ConfirmPassword"]</label>
            <input class="auth-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        </div>
        <button class="auth-btn" type="submit">@T["Activate.Submit"]</button>
        <partial name="_Errors" />
    </form>
}
