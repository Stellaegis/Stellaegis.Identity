@page "/login"
@model LoginModel
@{
    ViewData["Title"] = T["Login.Title"];
    Layout = "_AuthLayout";
}

<h2 class="auth-h2">@T["Login.Heading"]</h2>
<p class="auth-help">@T["Login.Help"]</p>

@if (TempData["Notice"] is string notice)
{
    <div class="auth-success" role="status">@T[notice]</div>
}

<form class="auth-form" method="post" autocomplete="on">
    <div class="auth-field">
        <label class="auth-label" for="Input_Email">@T["Field.Email"]</label>
        <input class="auth-input" asp-for="Input.Email" type="email" autocomplete="username" autofocus />
    </div>
    <div class="auth-field">
        <label class="auth-label" for="Input_Password">@T["Field.Password"]</label>
        <input class="auth-input" asp-for="Input.Password" type="password" autocomplete="current-password" />
    </div>
    <div class="auth-row">
        <label class="auth-check"><input asp-for="Input.RememberMe" type="checkbox" /> @T["Login.RememberMe"]</label>
    </div>
    <button class="auth-btn" type="submit">@T["Login.Submit"]</button>
    <partial name="_Errors" />
</form>

<div class="auth-links">
    @if (Model.RegistrationOpen)
    {
        <a href="@Links.WithReturnUrl("/register", Model.ReturnUrl)" class="auth-btn auth-btn-secondary">@T["Login.Register"]</a>
    }
    @if (Model.PasswordResetEnabled)
    {
        <a href="/forgot-password" class="auth-link">@T["Login.Forgot"]</a>
    }
</div>
