@page "/account/mfa"
@model AccountMfaModel
@{
    ViewData["Title"] = T["Account.Mfa.Title"];
    Layout = "_AccountLayout";
}

@if (TempData["Notice"] is string notice)
{
    <div class="auth-success" role="status">@T[notice]</div>
}

@if (Model.IsEnabled)
{
    <div class="auth-success">
        <strong>@(Model.Method == MfaMethod.Email ? T["Account.Mfa.ActiveEmail"] : T["Account.Mfa.ActiveApp"])</strong>
        @if (Model.EnabledAt is { } enabledAt)
        {
            <span> — @T.Format("Account.Mfa.Since", enabledAt.ToLocalTime())</span>
        }
    </div>
    <p class="auth-help">@T["Account.Mfa.DisableHelp"]</p>
    <form class="auth-form" method="post" asp-page-handler="Disable" autocomplete="off">
        <div class="auth-field">
            <label class="auth-label" for="Password">@T["Field.Password"]</label>
            <input class="auth-input" asp-for="Password" type="password" autocomplete="current-password" autofocus />
        </div>
        <button type="submit" class="auth-btn auth-btn-danger">@T["Account.Mfa.Disable"]</button>
        <partial name="_Errors" />
    </form>
    <div class="auth-links">
        <a href="/account/mfa/recovery-codes" class="auth-link">@T["Account.Nav.RecoveryCodes"]</a>
    </div>
}
else
{
    <p class="auth-help">@T["Account.Mfa.Explain"]</p>
    <div class="auth-choices">
        <div class="auth-choice">
            <div class="auth-choice-title">@T["Account.Mfa.AppTitle"]</div>
            <p class="auth-help">@T["Account.Mfa.AppHelp"]</p>
            <a href="/account/mfa/setup" class="auth-btn">@T["Account.Mfa.AppSetup"]</a>
        </div>
        <div class="auth-choice">
            <div class="auth-choice-title">@T["Account.Mfa.EmailTitle"]</div>
            <p class="auth-help">@T["Account.Mfa.EmailHelp"]</p>
            <form method="post" asp-page-handler="EnableEmail">
                <button type="submit" class="auth-btn">@T["Account.Mfa.EmailEnable"]</button>
            </form>
        </div>
    </div>
    <partial name="_Errors" />
}
