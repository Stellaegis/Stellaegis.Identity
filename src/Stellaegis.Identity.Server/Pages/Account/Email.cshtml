@page "/account/email"
@model AccountEmailModel
@{
    ViewData["Title"] = T["Account.Email.Title"];
    Layout = "_AccountLayout";
}

@if (TempData["ApprovalSentTo"] is string approvalSentTo)
{
    <div class="auth-success" role="status">@T.Format("Account.Email.ApprovalSent", approvalSentTo)</div>
}

@if (Model.Pending is { } pending)
{
    <p class="auth-help">@T.Format("Account.Email.CodeSent", pending)</p>
    <form class="auth-form" method="post" asp-page-handler="Confirm" autocomplete="off">
        <div class="auth-field">
            <label class="auth-label" for="Code">@T["Field.Code"]</label>
            <input class="auth-input auth-input-code" asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus />
        </div>
        <button class="auth-btn" type="submit">@T["Account.Email.Confirm"]</button>
        <partial name="_Errors" />
    </form>
    <div class="auth-links">
        <form method="post" asp-page-handler="Cancel">
            <button type="submit" class="auth-link">@T["Account.Email.StartOver"]</button>
        </form>
    </div>
}
else
{
    <p class="auth-help">@T.Format("Account.Email.Current", Model.CurrentEmail)</p>
    @if (Model.CurrentVerified)
    {
        <p class="auth-help">@T["Account.Email.Verified"]</p>
    }
    else
    {
        <p class="auth-help">@T["Account.Email.Unverified"]</p>
        <form class="auth-form" method="post" asp-page-handler="Verify">
            <button class="auth-btn auth-btn-secondary" type="submit">@T["Account.Email.Verify"]</button>
        </form>
    }
    <form class="auth-form" method="post" autocomplete="off">
        <div class="auth-field">
            <label class="auth-label" for="NewEmail">@T["Field.NewEmail"]</label>
            <input class="auth-input" asp-for="NewEmail" type="email" autocomplete="email" autofocus />
        </div>
        <p class="auth-help">@T["Account.Email.PasswordHelp"]</p>
        <div class="auth-field">
            <label class="auth-label" for="Password">@T["Field.Password"]</label>
            <input class="auth-input" asp-for="Password" type="password" autocomplete="current-password" />
        </div>
        <button class="auth-btn" type="submit">@T["Account.Email.SendCode"]</button>
        <partial name="_Errors" />
    </form>
}
