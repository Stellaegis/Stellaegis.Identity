@page "/account/delete"
@model AccountDeleteModel
@{
    ViewData["Title"] = T["Account.Delete.Title"];
    Layout = "_AccountLayout";
}

<div class="auth-errors" role="alert">
    <strong>@T["Account.Delete.Irreversible"]</strong><br />
    @T["Account.Delete.Explain"]
</div>

<form class="auth-form" method="post" autocomplete="off">
    <div class="auth-field">
        <label class="auth-label" for="Password">@T["Field.ConfirmWithPassword"]</label>
        <input class="auth-input" asp-for="Password" type="password" autocomplete="current-password" autofocus />
    </div>
    <button type="submit" class="auth-btn auth-btn-danger">@T["Account.Delete.Submit"]</button>
    <partial name="_Errors" />
</form>
