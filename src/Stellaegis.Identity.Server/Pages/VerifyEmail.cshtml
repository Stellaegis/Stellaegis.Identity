@page "/verify-email"
@model VerifyEmailModel
@{
    ViewData["Title"] = T["VerifyEmail.Title"];
    Layout = "_AuthLayout";
}

<h2 class="auth-h2">@T["VerifyEmail.Heading"]</h2>
<p class="auth-help">@T.Format("VerifyEmail.Help", Model.Email)</p>

@if (TempData["SendFailed"] is true)
{
    <div class="auth-warning" role="alert">@T["VerifyEmail.SendFailed"]</div>
}
@if (TempData["Resent"] is true)
{
    <div class="auth-success" role="status">@T["VerifyEmail.Resent"]</div>
}

<form class="auth-form" method="post" autocomplete="off">
    <div class="auth-field">
        <label class="auth-label" for="Code">@T["Field.Code"]</label>
        <input class="auth-input auth-input-code" asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" autofocus />
    </div>
    <button class="auth-btn" type="submit">@T["VerifyEmail.Submit"]</button>
    <partial name="_Errors" />
</form>

<div class="auth-links">
    <form method="post" asp-page-handler="Resend">
        <button type="submit" class="auth-btn auth-btn-secondary">@T["VerifyEmail.Resend"]</button>
    </form>
    <a href="@Links.WithReturnUrl("/register", Model.ReturnUrl)" class="auth-link">@T["VerifyEmail.ChangeDetails"]</a>
</div>
