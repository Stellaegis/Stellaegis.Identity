@*
    The account of a signed-in person: a navigation on the side, the page in the middle, the way out at the bottom.
*@
@using System.Security.Claims
@{
    Layout = "_Layout";
    var o = PagesOptions.Value;
    var path = Context.Request.Path.Value ?? "";
    Func<string, string> activeIf = p =>
        (p == "/account" ? path.Equals(p, StringComparison.OrdinalIgnoreCase) : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? " active" : "";
    var email = User.FindFirstValue("email") ?? User.FindFirstValue(ClaimTypes.Email) ?? "";
}
<div class="account-layout">
    <header class="account-topbar">
        <div class="account-topbar-brand">
            @if (!string.IsNullOrEmpty(o.LogoPath))
            {
                <img class="account-topbar-logo" src="@o.LogoPath" alt="" />
            }
            <span class="account-topbar-name">@o.ApplicationName</span>
            <span class="account-topbar-sub">@T["Account.Title"]</span>
        </div>
        <div class="account-topbar-user">@email</div>
    </header>
    <div class="account-body">
        <nav class="account-sidebar" aria-label="@T["Account.Title"]">
            <div class="account-nav-group">
                <div class="account-nav-group-title">@T["Account.Nav.Profile"]</div>
                <a href="/account" class="account-nav-item@(activeIf("/account"))">@T["Account.Nav.Overview"]</a>
                <a href="/account/password" class="account-nav-item@(activeIf("/account/password"))">@T["Account.Nav.Password"]</a>
                <a href="/account/email" class="account-nav-item@(activeIf("/account/email"))">@T["Account.Nav.Email"]</a>
            </div>
            <div class="account-nav-group">
                <div class="account-nav-group-title">@T["Account.Nav.Security"]</div>
                <a href="/account/security" class="account-nav-item@(activeIf("/account/security"))">@T["Account.Nav.Logins"]</a>
                <a href="/account/mfa" class="account-nav-item@(activeIf("/account/mfa"))">@T["Account.Nav.Mfa"]</a>
            </div>
            <div class="account-nav-group">
                <div class="account-nav-group-title">@T["Account.Nav.Account"]</div>
                <a href="/account/delete" class="account-nav-item danger@(activeIf("/account/delete"))">@T["Account.Nav.Delete"]</a>
            </div>
            <div class="account-sidebar-footer">
                <partial name="_LanguagePicker" />
                <form method="post" action="/account?handler=Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account-logout-btn">@T["Account.Logout"]</button>
                </form>
            </div>
        </nav>
        <main class="account-content" role="main">
            <h1 class="account-page-title">@ViewData["Title"]</h1>
            @RenderBody()
        </main>
    </div>
</div>

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
