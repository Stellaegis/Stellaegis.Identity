@*
    The languages the pages have texts for, in a list named in its own language, and the button that applies the
    choice: posted to /language, which keeps it and returns to this page. A button rather than a change of the list
    sending it, which would move the page while a keyboard is still going through the list. Absent when the host
    imposes a culture, or when the pages have texts for one language only.
*@
@using System.Globalization
@inject PagesCulture Cultures
@{
    var cultures = Cultures.Supported;
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var back = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}
@if (string.IsNullOrEmpty(PagesOptions.Value.Culture) && cultures.Count > 1)
{
    <form method="post" action="/language" class="language-picker">
        @Html.AntiForgeryToken()
        <input type="hidden" name="back" value="@back" />
        <select name="culture" class="language-select" aria-label="@T["Layout.Language"]">
            @foreach (var culture in cultures)
            {
                var name = culture.NativeName;
                <option lang="@culture.Name" value="@culture.Name" selected="@(culture.TwoLetterISOLanguageName == current)">@(char.ToUpper(name[0], culture) + name[1..])</option>
            }
        </select>
        <button type="submit" class="language-apply">@T["Layout.Language.Apply"]</button>
    </form>
}
