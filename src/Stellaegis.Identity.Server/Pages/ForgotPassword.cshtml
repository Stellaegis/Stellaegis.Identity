@page "/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = T["Forgot.Title"];
    Layout = "_AuthLayout";
}

@if (Model.Sent)
{
    <h2 class="auth-h2">@T["Forgot.SentHeading"]</h2>
    <p class="auth-help">@T.Format("Forgot.SentHelp", Model.LifetimeHours)</p>
    <p class="auth-help">@T["Forgot.SentSpam"]</p>
    <div class="auth-links">
        <a href="/login" class="auth-btn auth-btn-secondary">@T["Nav.BackToLogin"]</a>
    </div>
}
else
{
    <h2 class="auth-h2">@T["Forgot.Heading"]</h2>
    <p class="auth-help">@T["Forgot.Help"]</p>
    <form class="auth-form" method="post" autocomplete="on">
        <div class="auth-field">
            <label class="auth-label" for="Email">@T["Field.Email"]</label>
            <input class="auth-input" asp-for="Email" type="email" autocomplete="email" autofocus />
        </div>
        <button class="auth-btn" type="submit">@T["Forgot.Submit"]</button>
        <partial name="_Errors" />
    </form>
    <div class="auth-links">
        <a href="/login" class="auth-link">@T["Nav.BackToLogin"]</a>
    </div>
}
