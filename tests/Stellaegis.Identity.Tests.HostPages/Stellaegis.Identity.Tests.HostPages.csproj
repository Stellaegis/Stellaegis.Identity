<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- A host that replaced one page of the package by its own, at the same path: what the tests of the precedence
       add before the package, as an application does. Test-only, never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Identity.Tests.HostPages</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stellaegis.Identity.Server\Stellaegis.Identity.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
